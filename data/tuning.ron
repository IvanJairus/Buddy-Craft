// Cratebound tuning data.
//
// This file is the single source of truth for every number a designer would
// want to change. `crates/sim/src/tuning.rs` validates it at load and the test
// `tuning_matches_docs` asserts it still matches plan §4.3, §4.4 and §4.8.
//
// Editing rules:
//   * decimal values are converted to Q16.16 fixed-point exactly once, at load;
//   * the game never reads a float at runtime;
//   * a change here invalidates golden state hashes (T-015) if it affects rules.
(
  match: (
    target_minutes: 20,
    overtime_start_s: 1320,   // 22:00 — plan §4.2
    decay_per_30s: 0.02,      // +2% max HP per 30 s of overtime
  ),

  player: (
    hp: 100,
    respawn_s: 8,
    spawn_protect_s: 2,
    speed: 4.5,               // m/s
    radius: 0.3,              // AABB half-width
    height: 1.8,
  ),

  physics: (
    // Plan T-009 / §4.8. `jump_height` is the apex, and jump velocity is
    // derived from it as sqrt(2 * gravity * jump_height) so a designer tunes
    // the thing they can see rather than the thing the integrator consumes.
    gravity: 24.0,
    terminal_velocity: 50.0,
    jump_height: 1.25,
    step_up: 1.0,
    swim_speed: 2.0,
    swim_gravity_mult: 0.35,
    // Largest distance the collision sweep moves in one go. Must stay below
    // half the player's AABB width or a fast entity can tunnel a wall.
    max_substep: 0.2,
  ),

  core: (
    hp: 10000,
    damage_mult: 0.35,
    regen: 0.0,
  ),

  // Plan §4.8 (player weapons) and §4.6 (buddy weapons).
  //
  // `cooldown_s` is authored in seconds because that is how a designer thinks
  // about a swing; `crates/sim/src/tuning.rs` converts it to whole ticks at
  // load (0.45 s -> 9 ticks at 20 Hz) and combat only ever sees the integer.
  // `reach` is melee reach, or projectile flight distance.
  weapons: (
    fists:     (damage: 8,  cooldown_s: 0.50, reach: 2.2, profile: Melee),
    sword:     (damage: 25, cooldown_s: 0.45, reach: 2.6, profile: Melee),
    spear:     (damage: 20, cooldown_s: 0.55, reach: 3.6, profile: Melee),
    // The plan gives the bow no cadence; 0.70 s is the slowest player attack,
    // which keeps bow DPS (43) below sword DPS (56) so the sword stays the
    // damage option and range is the bow's compensation.
    bow:       (damage: 30, cooldown_s: 0.70, reach: 30.0,
                profile: Projectile(speed: 40.0)),
    // §4.6 Mage: 22 damage, 1.80 s, 10 m, AoE radius 2.5. §4.8 lists a
    // "Staff 40 dmg AoE r=2.5" with no owner and no cadence; the only thing
    // that casts is the Mage, so its §4.6 row is authoritative here.
    mage_bolt: (damage: 22, cooldown_s: 1.80, reach: 10.0,
                profile: Burst(speed: 20.0, radius: 2.5)),

    // Buddy weapons (§4.6). Damage, cadence and range live here rather than in
    // buddies.ron so there is exactly one table of damage numbers in the game.
    // The plan does not give projectile speeds for the archer or the sniper;
    // 30 and 60 m/s keep flight time under half a second at each role's range,
    // which is short enough that a target cannot walk out of the shot.
    swordsman_blade: (damage: 14, cooldown_s: 0.60, reach: 1.8,  profile: Melee),
    archer_bow:      (damage: 12, cooldown_s: 1.10, reach: 14.0, profile: Projectile(speed: 30.0)),
    healer_staff:    (damage: 15, cooldown_s: 1.50, reach: 8.0,  profile: Melee),
    berserker_axe:   (damage: 20, cooldown_s: 0.50, reach: 1.8,  profile: Melee),
    sniper_rifle:    (damage: 40, cooldown_s: 2.50, reach: 28.0, profile: Projectile(speed: 60.0)),
  ),

  airdrop: (
    first_drop_s: 10,
    interval_early_s: 25,
    interval_late_s: 15,
    late_after_s: 300,
    crates_per_player: 3,
    heavy_every: 5,
    heavy_mult: 1.75,
    telegraph_s: 5,
    fall_speed: 12.0,
    pickup_radius: 1.2,
    carry_cap: 12,
    drop_loss: 0.5,
    pickup_ttl_s: 180,
    max_pickups: 120,
  ),

  pad: (
    size: 8,
    max_height: 4,
    deposit_rate: 6,
  ),

  terrain: (
    // v1: terrain is indestructible; crates are the only placeable block.
    // Flipping this re-opens tunnelling and the full chunk-diff budget (§4.4.4).
    breakable: false,
  ),

  world: (
    size_x: 256,
    size_z: 256,
    height: 96,
    sea_level: 40,
    chunk: 16,
    base_radius: 96,
  ),
)
