// Cratebound recipe table.
//
// Shapes are pad-local coordinates `[x, y, z]` with y as the layer, y = 0
// resting on the pad floor. The recipe's *cost* is its block count, so the two
// can never disagree — there is no separate `cost` field to drift.
//
// Rules enforced at load (see crates/sim/src/recipe.rs):
//   * every recipe's lowest layer must be y = 0 (ground support, §4.5.1 rule 3)
//   * every block must fit inside the 8 x 4 x 8 pad
//   * no two recipes may share a canonical form, because matching is exact
//     equality of that form and a collision would make one recipe unreachable
//
// `unlock_s` is match time in seconds: tier 1 from the start, tier 2 at 3:00,
// tier 3 at 8:00 (§4.5.3). `cooldown_s` is per team.
[
  // --- Tier 1 -------------------------------------------------------------
  (
    id: "R01_SWORD",
    output: Sword,
    unlock_s: 0,
    cooldown_s: 20,
    // ###
    // ###   (3 x 2 slab)
    blocks: [
      [0,0,0],[1,0,0],[2,0,0],
      [0,0,1],[1,0,1],[2,0,1],
    ],
  ),
  (
    id: "R02_BOW",
    output: Bow,
    unlock_s: 0,
    cooldown_s: 20,
    // #..
    // #..
    // ###
    blocks: [
      [0,0,0],[0,0,1],[0,0,2],
      [1,0,2],[2,0,2],
    ],
  ),
  (
    id: "R03_BANDAGE",
    output: Bandage,
    unlock_s: 0,
    cooldown_s: 15,
