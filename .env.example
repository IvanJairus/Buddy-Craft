# Buddy Craft / Cratebound environment template.
#
# Copy this file when you need local configuration:
#   cp .env.example .env
#
# .env and .env.local are gitignored. Never put real tokens in this file.
#
# IMPORTANT: Rust binaries do not read .env automatically. Export it first:
#   set -a; source .env; set +a
# Vite does read .env.local automatically, but only inside apps/web and only
# exposes variables prefixed with VITE_. Copy just the VITE_ lines there:
#   cp .env.example apps/web/.env.local   # then trim the non-VITE_ sections
#
# Anything prefixed VITE_ is compiled into the public client bundle. It is not
# a secret. Real secrets belong in the host environment or CI secrets.

# ---------------------------------------------------------------------------
# Local host (cargo run -p host-axum)
# ---------------------------------------------------------------------------
# Bind address. Default: 127.0.0.1:8080.
CB_ADDR=127.0.0.1:8080

# Comma-separated browser Origins allowed to open the WebSocket. Empty or
# unset uses the four local defaults below. Add the exact Vercel origin here
# when testing a deployed client against a local host.
CB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Directory for room summary JSON. Default: target/room-summaries.
CB_SUMMARY_DIR=target/room-summaries

# Kill switches are read when the host starts. Restart to apply a change.
# false or 0 rejects new rooms; existing rooms finish.
ROOMS_ENABLED=true
# Minimum C_HELLO protocol version. Default: 1.
PROTOCOL_MIN_VERSION=1
# Optional deployment id recorded in /healthz. Uncomment to pin a client build.
# CLIENT_BUILD_OVERRIDE=vercel-deployment-id

# Test-only. Enables the /debug/command endpoint and E2E seats. Never enable
# this on a public host.
# CB_E2E=1

# ---------------------------------------------------------------------------
# Web client (apps/web)
# ---------------------------------------------------------------------------
# Vite reads these from apps/web/.env.local, not from the repository root.
# WebSocket URL for ONLINE. Unset falls back to ws://<current-hostname>:8080.
# A deployed HTTPS page needs wss://, for example:
# VITE_WS_URL=wss://buddy-craft-host.example.workers.dev
VITE_WS_URL=ws://127.0.0.1:8080

# Optional crash and wasm-trap ingest URL. The client POSTs the full URL with
# sendBeacon/fetch. Uncomment and point it at GlitchTip, Sentry or your own
# collector. Empty means reports stay in memory and are not sent.
# VITE_TELEMETRY_URL=https://telemetry.example.com/ingest

# ---------------------------------------------------------------------------
# Deployment credentials (CLI and CI only, not read by the app)
# ---------------------------------------------------------------------------
# Local login is interactive and does not need these:
#   npx wrangler@latest login
#   npx vercel@latest login
# Use tokens only as GitHub Actions secrets or shell environment variables.
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
# VERCEL_TOKEN=...
# VERCEL_ORG_ID=...
# VERCEL_PROJECT_ID=...
#
# T-046 and T-057 are not deployed yet. There is no wrangler.toml or Vercel
# project config in the repository until those tasks add it.

# ---------------------------------------------------------------------------
# Tests, benchmarks and diagnostic tools
# ---------------------------------------------------------------------------
# Starts the shared host-axum process for the Playwright E2E suite.
# E2E=1

# Runs the performance gates instead of skipping them.
# PERF_GATE=1

# Allows the noisy shared CI runner some headroom in cargo bench. Default 1.0.
# WORLD_BENCH_SLACK=3

# Bot balance report. Count is capped at 10. The seed defaults to 0xBA1A0000.
# BALANCE_COUNT=10
# BALANCE_SEED=0xBA1A0000

# Print a position line every 400 ticks (20 seconds) and every match event.
# BALANCE_TRACE=1

# Rewrites committed golden hashes. Use only when a deterministic protocol or
# worldgen change is deliberate, never to make a red test green.
# UPDATE_GOLDENS=1

# ---------------------------------------------------------------------------
# Planned names that current code does NOT read yet
# ---------------------------------------------------------------------------
# The plan's §17 table lists these, but T-046/T-056 are not wired:
#   SESSION_SIGNING_KEY
#   ROOM_REGISTRY_TOKEN
#   SENTRY_DSN
#   VITE_SENTRY_DSN
#   VITE_GAME_WS_URL  (older plan name; the code reads VITE_WS_URL instead)
# Do not expect these to have any effect in the current build.
